@model List<Bulky.Models.Movie>

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">
                Movie List
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Movie" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Movie
            </a>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Description</th>
                <th></th> </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.OrderBy(u => u.Title))
            {
                <tr>
                    <td>@obj.Title</td>
                    <td>@obj.Genre</td>
                    <td>
                        @if (!string.IsNullOrEmpty(obj.Description) && obj.Description.Length > 50)
                        {
                            @obj.Description.Substring(0, 50) <span>...</span>
                        }
                        else
                        {
                            @obj.Description
                        }
                    </td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Movie" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-controller="Movie" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger mx-2">
                                <i class="bi bi-trash-fill"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>